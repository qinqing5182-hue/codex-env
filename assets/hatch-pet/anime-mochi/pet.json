    "expressions": [
      { "id": "idle", "label": "Idle", "asset": "expressions/idle.svg" },
      { "id": "happy", "label": "Happy", "asset": "expressions/happy.svg" },
      { "id": "sleepy", "label": "Sleepy", "asset": "expressions/sleepy.svg" },
      { "id": "angry", "label": "Angry", "asset": "expressions/angry.svg" },
      { "id": "surprised", "label": "Surprised", "asset": "expressions/surprised.svg" }
    ],
    "idleAnimations": ["float", "sway", "blink"]
  }
}
